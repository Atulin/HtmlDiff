{
	"compilerOptions": {
		"lib": ["ESNext"],
		"target": "ESNext",
		"module": "preserve",
		"moduleDetection": "force",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true,
		"isolatedDeclarations": true,
		"declaration": true,
		"types": ["bun"]
	}
}
